+class _TimmSpatialBackbone(nn.Module):
+    """Adapter for timm backbones that expose neither `.features` nor pooling.
+
+    `CXRNet` needs two things from a backbone: a pooled vector for the default path and
+    the pre-pooling feature map for LSE pooling. torchvision models hand both over via
+    `.features`; timm's RepViT returns a B x C x H x W map from `forward_features` and
+    pools only inside its classifier, so the two accesses are provided here instead of
+    special-casing the callers.
+    """
+
+    def __init__(self, net: nn.Module):
+        super().__init__()
+        self.net = net
+        self.feat_dim = int(net.num_features)
+
+    def features(self, x):
+        f = self.net.forward_features(x)
+        if f.dim() == 4 and f.shape[-1] > f.shape[1]:
+            f = f.permute(0, 3, 1, 2)          # B,H,W,C -> B,C,H,W
+        return f
+
+    def forward(self, x):
+        return self.features(x).mean(dim=(2, 3))
+
+
